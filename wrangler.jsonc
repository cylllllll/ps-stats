{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ps-stats",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-03",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "secrets": {
    "required": [
      "PSN_NPSSO"
    ]
  }
}
